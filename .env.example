# Bắt buộc: development, test hoặc production. Khác production thì /v1/auth/dev-login và /docs được bật.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=llhq

# Tạo chuỗi ngẫu nhiên: node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
JWT_ISSUER=llhq-api
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

BODY_LIMIT_BYTES=512000
# Số proxy / load balancer đứng trước server (false = không có, true = 1, hoặc một số), để lấy đúng IP người dùng
# từ X-Forwarded-For. Đặt đúng số proxy thật: đặt thừa thì client giả được IP và vượt được giới hạn đăng nhập.
TRUST_PROXY=false
LOG_LEVEL=info

# Đăng nhập Apple, Google: danh sách client id phân cách bằng dấu phẩy; để trống thì route trả 503
# Apple: bundle id của app iOS, ví dụ com.example.llhq
APPLE_CLIENT_IDS=
# Google: client id OAuth của app iOS, Android và web (Expo dùng client id web)
GOOGLE_CLIENT_IDS=

# Origin được gọi API từ trình duyệt (bản web của app Expo), phân cách bằng dấu phẩy; để trống là tắt CORS.
# App iOS, Android không cần. Dev: http://localhost:8081
CORS_ORIGINS=
