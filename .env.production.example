# Mẫu cấu hình production. Chép thành .env.production (file đó bị .gitignore bỏ qua) rồi điền giá trị thật.
# - Trên Render: nhập các biến này ở mục Environment của service (Render không đọc file này).
# - Trên máy: dùng cho các lệnh chạy vào database production, vì gói Free của Render không có Shell:
#   pnpm seed:prod, pnpm seed:config:prod, pnpm set-role:prod <apple|google> <sub> admin, pnpm migrate:prod

# Bắt buộc. production thì tắt /v1/auth/dev-login và /docs
NODE_ENV=production

# MongoDB Atlas (replica set, cần cho transaction khi xóa tài khoản).
# Mật khẩu có ký tự đặc biệt (@ : / ? # %) thì phải mã hóa URL, ví dụ @ thành %40
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Tách hẳn với dev (llhq_dev) dù dùng chung cluster
MONGODB_DB=llhq

# Chuỗi ngẫu nhiên riêng cho production, KHÔNG dùng lại của dev:
# node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=llhq-api
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

BODY_LIMIT_BYTES=512000
# Số proxy đứng trước server; Render có 1 lớp proxy
TRUST_PROXY=1
LOG_LEVEL=info

# Render tự cấp PORT; HOST mặc định 0.0.0.0
# PORT=

# Đăng nhập Apple, Google: điền khi có (để trống thì route trả 503)
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=

# Để trống nếu không phát hành bản web
CORS_ORIGINS=
